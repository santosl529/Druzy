# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI provider — set the one matching lib/ai/config.ts
OPENROUTER_API_KEY=  # default; get yours at openrouter.ai/keys
# ANTHROPIC_API_KEY= # alternative; swap provider in lib/ai/config.ts
# OPENAI_API_KEY=    # alternative; swap provider in lib/ai/config.ts
# XAI_API_KEY=       # alternative (Grok); swap provider in lib/ai/config.ts

# Local Ollama — journal transcription (runs on your machine, never sent to cloud)
# Start Ollama with CORS allowed for your app origin:
#   OLLAMA_ORIGINS="http://localhost:3000,https://your-app.vercel.app" ollama serve
# Then pull a vision model:
#   ollama pull qwen2.5vl
# (Avoid llama3.2-vision / mllama — it crashes the llama.cpp runner on several
#  Ollama builds. qwen2.5vl runs on the native engine and is great at handwriting.)
NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434   # default; override if Ollama runs elsewhere
NEXT_PUBLIC_OLLAMA_JOURNAL_MODEL=qwen2.5vl           # default; any Ollama vision model works

